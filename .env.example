# Copier en .env et renseigner des valeurs propres à l'environnement (ne jamais versionner .env)
POSTGRES_DB=gcm
POSTGRES_USER=gcm
# Production : 12 caractères minimum (ex. : openssl rand -base64 24)
POSTGRES_PASSWORD=
# Secret de signature des jetons JWT : 48 octets minimum en production (openssl rand -base64 48)
GCM_JWT_SECRET=
# Développement uniquement : mot de passe des comptes de démonstration (vide = aucun compte de démonstration).
# Ignoré en production (docker-compose.prod.yml).
GCM_DEMO_PASSWORD=
# Production : mot de passe initial du compte « admin » (12 caractères minimum), créé au premier démarrage
GCM_ADMIN_PASSWORD=
# Import automatique des référentiels depuis le classeur Excel au premier démarrage
GCM_SEED=true
# Interface web : port exposé (production : derrière un reverse proxy HTTPS, lié à 127.0.0.1 par défaut)
GCM_HTTP_PORT=80
# GCM_HTTP_BIND=127.0.0.1
# Production : exposer la documentation OpenAPI (/swagger-ui.html) aux partenaires
# GCM_SWAGGER=false
