# Copier en .env et renseigner des valeurs propres à l'environnement (ne jamais versionner .env)
POSTGRES_DB=gcm
POSTGRES_USER=gcm
POSTGRES_PASSWORD=
# Secret de signature des jetons JWT : 32 octets minimum (ex. : openssl rand -base64 48)
GCM_JWT_SECRET=
# Mot de passe initial des comptes de démonstration créés par le seed (à changer dès la première connexion)
GCM_DEMO_PASSWORD=
# Import automatique des référentiels depuis le classeur Excel au premier démarrage
GCM_SEED=true
# Port HTTP exposé par l'interface web
GCM_HTTP_PORT=80
